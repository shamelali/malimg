# PostgreSQL/PostGIS connection. The app also runs with seeded in-memory data when this is absent.
# Local Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_APP_NAME=Smart Gunung Lambak

# Optional smoke-test/service key accepted as x-api-key with all demo capabilities.
DEMO_API_KEY=replace-with-a-long-random-key

# For Capacitor/native builds, set this to the deployed HTTPS web app origin.
# LAMBAK_PUBLIC_URL=https://lambak.example.gov.my
